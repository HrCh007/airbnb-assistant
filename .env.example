# =============================================================================
# Delhi Stays Guest Assistant - environment configuration
# Copy to `.env` (backend reads ./.env or ../.env). NEVER commit real secrets.
# Keep comments on their own lines: Docker Compose treats a comment after an
# empty value (KEY=  # note) as the value itself.
# Every integration is optional in development; see docs/setup.md.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# used for CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Extra comma-separated CORS origins (e.g. Vercel preview URLs)
CORS_EXTRA_ORIGINS=

# --- Database (PostgreSQL 15+ with the pgvector extension) ---------------------
# Local: postgresql://airbnb:airbnb@localhost:5432/airbnb_assistant
# Supabase: Project Settings -> Database -> Connection string (URI). Use the
#   session pooler (port 5432) or direct connection; append ?ssl=require if needed.
DATABASE_URL=postgresql://airbnb:airbnb@localhost:5432/airbnb_assistant

# --- Security ------------------------------------------------------------------
# Required in production: 32+ random characters, e.g. `openssl rand -hex 32`
SECRET_KEY=
ADMIN_TOKEN_TTL_MINUTES=720
# First admin account, created by `python -m scripts.seed` (or use scripts.create_admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5
MAX_UPLOAD_MB=10

# --- Anthropic Claude (answers + query planning) --------------------------------
# https://console.anthropic.com/ -> API Keys. Without it the assistant runs in
# offline extractive mode (quotes the property guide; no generated prose).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_PLANNER_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_ANSWER_EFFORT=medium
CLAUDE_PLANNER_EFFORT=low
CLAUDE_ENABLE_REFUSAL_FALLBACK=true
# SYSTEM_PROMPT_PATH=/path/to/custom_system_prompt.md

# --- Embeddings ----------------------------------------------------------------
# auto = OpenAI when OPENAI_API_KEY is set, otherwise the local lexical embedder.
# Changing provider requires re-indexing (POST /api/admin/documents/reindex-all).
# auto | openai | local
EMBEDDING_PROVIDER=auto
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# must match the migration (vector(1536))
EMBEDDING_DIM=1536

# --- RAG -------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
HYBRID_SEARCH=true

# --- Google Places API (New) ------------------------------------------------------
# Google Cloud Console -> enable "Places API (New)" -> Credentials -> API key.
# Restrict the key to the Places API (New) and, in production, to your backend's IP.
GOOGLE_MAPS_API_KEY=
# auto | google | mock (dev only, fictional) | disabled
PLACES_PROVIDER=auto
DEFAULT_DISCOVERY_RADIUS_M=3000
PLACES_CACHE_TTL_SECONDS=600
# Ranking weights (normalised): relevance, distance, rating, open-now, preference fit
RANK_WEIGHT_RELEVANCE=0.25
RANK_WEIGHT_DISTANCE=0.25
RANK_WEIGHT_RATING=0.30
RANK_WEIGHT_OPEN=0.10
RANK_WEIGHT_PREFERENCE=0.10

# --- Supabase (optional; only DATABASE_URL is required to use Supabase Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (set in Vercel / frontend/.env.local) -----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
