# =============================================================================
# Hideout Studios Guest Assistant - configuration (all optional)
#
# Copy to `.env` next to docker-compose.yml. Every value has a working default,
# no API keys exist, and nothing here costs money. NEVER commit `.env`.
# Keep comments on their own lines: Docker Compose treats a comment after an
# empty value (KEY=  # note) as the value itself.
# =============================================================================

# --- Admin console ------------------------------------------------------------
# The first admin account is created on first start. If you leave these empty,
# a development account is created: admin@example.com / ChangeMe-Dev-2026!
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Local LLM (Ollama) ---------------------------------------------------------
# Pick a model that fits your RAM (docs/docker-windows.md#choosing-a-model):
#   qwen3:4b (~2.6 GB, needs ~12 GB for Docker), qwen3:1.7b (default, ~1.4 GB),
#   gemma3:1b (~0.8 GB), qwen3:0.6b (~0.5 GB)
OLLAMA_MODEL=qwen3:1.7b
# How long the model stays loaded in memory after a request.
OLLAMA_KEEP_ALIVE=30m
# Set to false to disable the LLM entirely (answers quote the property guide).
LLM_ENABLED=true

# --- Neighbourhood discovery (OpenStreetMap, free) -------------------------------
# Live searches use the public Overpass API. Its usage policy asks for an
# identifying User-Agent: put your business name and an email address here.
OSM_USER_AGENT=HideoutStudiosGuestAssistant/1.0 (self-hosted; contact: you@example.com)
DISCOVERY_LIVE=true
# Free public Overpass servers, tried in order until one answers.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Fictional sample places as a last resort (demo only). Leave false for real use:
# a failed live search then says so instead of showing made-up places.
DISCOVERY_SAMPLE_DATA=false
DEFAULT_DISCOVERY_RADIUS_M=3000

# --- Data -------------------------------------------------------------------------
# Load the three fictional demo properties when the database is empty.
AUTO_SEED_SAMPLE_DATA=true

# --- Security ----------------------------------------------------------------------
# Leave empty to auto-generate one (stored in the app_data volume).
SECRET_KEY=
RATE_LIMIT_CHAT_PER_MINUTE=20
MAX_UPLOAD_MB=10

# --- Ports (host side) ----------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Advanced (defaults are fine) -------------------------------------------------------
LOG_LEVEL=INFO
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
# Embedding model baked into the backend image (changing it requires a rebuild).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
